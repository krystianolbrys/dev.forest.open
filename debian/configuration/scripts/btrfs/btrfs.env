# shellcheck shell=bash

# Main Btrfs block device
BTRFS_DEV="${BTRFS_DEV:-/dev/mapper/nvme0n1p3_crypt}"

# Temporary mountpoint for Btrfs top-level, subvolid=5
BTRFS_MNT="${BTRFS_MNT:-/mnt/btrfs-root}"

# Subvolumes
ROOT_SUBVOL="${ROOT_SUBVOL:-@rootfs}"
SNAPSHOT_ROOT="${SNAPSHOT_ROOT:-@snapshots}"
SWAP_SUBVOL="${SWAP_SUBVOL:-@swap}"

# Boot paths
BOOT_SRC="${BOOT_SRC:-/boot/}"
EFI_SRC="${EFI_SRC:-/boot/efi/}"

BOOT_DST="${BOOT_DST:-/boot/}"
EFI_DST="${EFI_DST:-/boot/efi/}"

# Swap
SWAP_MOUNT="${SWAP_MOUNT:-/swap}"
SWAPFILE="${SWAPFILE:-/swap/swapfile}"
SWAP_SIZE="${SWAP_SIZE:-512m}"
